# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Timezone Configuration
TZ=Asia/Jakarta

# =============================================================================
# POSTGRESQL CONFIGURATION
# =============================================================================
POSTGRESQL_DATABASE=
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=

# =============================================================================
# N8N CONFIGURATION
# =============================================================================
N8N_HOST=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/webhook

# N8N Security (Optional)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
GF_SERVER_ROOT_URL=http://localhost:3000

# =============================================================================
# SSL/TLS CONFIGURATION (Optional)
# =============================================================================
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Email Configuration for Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=notifications@yourdomain.com

# Slack Integration (Optional)
SLACK_WEBHOOK_URL=

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Ollama Configuration
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=24h
OLLAMA_HOST=http://localhost:11434

# PostgreSQL Configuration
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus Configuration
PROMOTHEUS_HOST=http://localhost:9090
PROMETHEUS_RETENTION_TIME=200h
PROMETHEUS_SCRAPE_INTERVAL=15s

# Alert Manager (Optional)
ALERTMANAGER_WEBHOOK_URL=http://localhost:9093/api/v1/alerts

#KUMA
KUMA_HOST_URL=http://localhost:3001

#NGINX
NGINX_HOST_URL=http://localhost

#NODEEXPORTER
NODEEXPORTER_HOST_URL=http://localhost:9100

